# =============================================================================
# Invoice Command Center - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# AI/ML Services - Google Gemini API (REQUIRED)
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/
# This is required for invoice PDF extraction and analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
# Model to use for invoice extraction (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_CONTRACT_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Database Configuration - PostgreSQL (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for the application database
# Format: postgresql://username:password@host:port/database_name
# Example for local PostgreSQL:
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_cc_db

# -----------------------------------------------------------------------------
# Application Configuration (Optional)
# -----------------------------------------------------------------------------
# Base path for API routes (leave empty for root)
BASE_PATH=

# Application environment
APP_ENV=development

# Authentication secret key
AUTH_SECRET_KEY=your_auth_secret_key_here

# -----------------------------------------------------------------------------
# Logging Configuration (Optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file: cp env.example .env
# 2. Get Google Gemini API key: https://aistudio.google.com/
# 3. Fill in GEMINI_API_KEY with your key
# 4. Set up PostgreSQL database and update DATABASE_URL
# 5. Generate AUTH_SECRET_KEY (or use provided one)
# 6. Run database migrations: alembic upgrade head
# 7. Seed initial data: python scripts/seed_ap_data.py
# =============================================================================

